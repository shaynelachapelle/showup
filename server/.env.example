# Author: Shayne Lachapelle
# Copy to server/.env and fill in. Never commit .env.
PORT=3000

# MongoDB on the same machine (locally and on the group server).
MONGO_URI=mongodb://127.0.0.1:27017/showup

# Signs login tokens. Use a long random value, different on every machine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Password for all seeded accounts. This value is public, use a private one on the group server.
SEED_PASSWORD=showup-demo

# true on the group server (HTTPS). Keep false locally (HTTP).
COOKIE_SECURE=false

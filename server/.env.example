# Author: Shayne Lachapelle
# Copy to server/.env and fill in. Never commit .env.
PORT=3000

# Local development: MongoDB Community Server on your own machine.
MONGO_URI=mongodb://localhost:27017/showup
# Mimi (self-hosted, password-protected), only in the .env on Mimi:
# MONGO_URI=mongodb://showup:<password>@127.0.0.1:<port>/showup?authSource=showup

# Signs login tokens. Use a long random value, different on every machine. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
